# Copy to .env or export before `go run ./cmd/authd`.
# Values shown are the built-in defaults (internal/config/config.go). Uncomment to override.
# Local `go run`: DATABASE_URL points at localhost. In docker compose, authd gets
# DATABASE_URL and SMTP_HOST rewritten to the sibling services `postgres`/`mailpit`.

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable
# HTTP_ADDR=:8080
# GRPC_ADDR=:9090
# GRPC_TLS_CERT_FILE=                 # set together with GRPC_TLS_KEY_FILE
# GRPC_TLS_KEY_FILE=
# GRPC_REFLECTION=false              # enable only for trusted development environments
# GRPC_MAX_RECEIVE_BYTES=4194304
# GRPC_MAX_SEND_BYTES=4194304
# SHUTDOWN_TIMEOUT=10s
# LOG_LEVEL=info                       # debug | info | warn | error

# ── Secrets (AES-256: exactly 64 hex chars = 32 bytes; defaults suit LOCAL DEV ONLY) ──
# If you see "got 33 bytes", delete the last two characters (e.g. …1e1f20 → …1e1f).
PASSWORD_HISTORY_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SIGNING_KEY_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# ── JWT / signing keys ────────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h               # 30 days
# SIGNING_KEY_GRACE_PERIOD=15m         # old key still verifies during this window after rotation
# SIGNING_KEY_ROTATE_EVERY=0           # background auto-rotation interval; 0 disables

# ── Password policy ───────────────────────────────────────────────────────────
# PASSWORD_MAX_AGE=2160h               # 90 days; 0 disables expiry
# PASSWORD_HISTORY_N=10                # reject reuse of the last N passwords

# ── OTP / magic link ──────────────────────────────────────────────────────────
# OTP_CODE_TTL=10m
# OTP_CODE_LENGTH=6
# OTP_MAX_ATTEMPTS=5                  # reset code is consumed after this many wrong attempts
# OTP_RESET_MIN_INTERVAL=1m           # minimum interval between reset emails for an account
# MAGIC_LINK_TTL=15m

# ── Sessions & login throttling ───────────────────────────────────────────────
# MAX_SESSIONS_PER_USER=10             # oldest session evicted beyond this
# LOGIN_FAIL_WINDOW=15m
# LOGIN_FAIL_MAX=5                     # lock the account after this many fails in the window
# LOGIN_LOCK_DURATION=30m
# LOGIN_NOTIFY_FAIL_THRESHOLD=3        # email a security alert at this many fails; 0 disables

# ── SMTP (Mailpit for local dev) ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=auth@localhost

# ── URLs ──────────────────────────────────────────────────────────────────────
# APP_PUBLIC_URL=http://localhost:8080
# REGISTRATION_INVITE_BASE_URL=http://localhost:5173   # Vite dev origin; Compose overrides to :8080

# ── Bootstrap superuser (created on first start when no human users exist) ─────
# BOOTSTRAP_SUPERUSER_LOGIN=admin
# BOOTSTRAP_SUPERUSER_EMAIL=admin@localhost
# BOOTSTRAP_SUPERUSER_PASSWORD=Adm1n!Passw0rd123

# ── Cookies / CSRF / CORS ─────────────────────────────────────────────────────
# REFRESH_COOKIE_NAME=refresh_token
# CSRF_HEADER_NAME=X-CSRF-Token
# REFRESH_COOKIE_SECURE=false          # set true behind HTTPS in production
# CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated

# ── docker-compose.yml only (${VAR} substitution + postgres/mailpit containers) ──
# Keep POSTGRES_* in sync with DATABASE_URL credentials.
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth
# POSTGRES_PORT=5432
# HTTP_PORT=8080
# GRPC_PORT=9090
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
