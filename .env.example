# Copy to .env or export before `go run ./cmd/authd`
# Local `go run`: DATABASE_URL points at localhost. In docker compose, authd gets DATABASE_URL rewritten to host `postgres`.
DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable

# Used by docker-compose.yml (${VAR} substitution + postgres container). Keep in sync with DATABASE_URL credentials.
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth
# POSTGRES_PORT=5432
# HTTP_PORT=8080
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# Exactly 64 hex chars (32 bytes). If you see "got 33 bytes", delete the last two characters (e.g. …1e1f20 → …1e1f).
PASSWORD_HISTORY_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SIGNING_KEY_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=auth@localhost
